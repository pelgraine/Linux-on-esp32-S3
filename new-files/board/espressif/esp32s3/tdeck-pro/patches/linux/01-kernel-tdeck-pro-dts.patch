--- a/arch/xtensa/boot/dts/esp32s3-tdeck-pro.dts	1970-01-01 00:00:00.000000000 +0000
+++ b/arch/xtensa/boot/dts/esp32s3-tdeck-pro.dts	2026-08-30 03:49:32.477373053 +0000
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * LilyGo T-Deck Pro V1.1 (4G version) -- build one.
+ *
+ * What this describes: the USB-C port as the Linux console, the WiFi link
+ * to the core-0 firmware, an I2C bus on GPIO 13/14, and the SD card slot
+ * on SPI2. Nothing else on the board is touched: e-paper, keyboard, touch,
+ * LoRa, GPS and the A7682E modem all stay unconfigured and unpowered.
+ *
+ * Pin numbers come from the pelgraine/Meck T-Deck Pro variant and from
+ * LilyGo's V1.1 schematic (H693 H779 T-DeckPro V1.1 25-09-15).
+ */
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include "gpio-esp32.h"
+#include "esp32s3.dtsi"
+
+/ {
+	chosen {
+		/*
+		 * Console on the USB-Serial-JTAG peripheral (the USB-C port).
+		 * esp32s3.dtsi lists that port as serial3, so it is ttyGS3.
+		 * UART0 on GPIO 43/44 is wired to the GPS on this board and is
+		 * deliberately not the console.
+		 */
+		bootargs = "earlycon=esp32s3acm,mmio32,0x60038000 console=ttyGS3 rw root=mtd:rootfs no_hash_pointers ";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* 8 MB PSRAM, placed here by the firmware's init_linux_mmap() */
+		reg = <0x3d800000 0x00800000>;
+	};
+
+	i2c0 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "i2c-gpio";
+
+		sda-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+
+		pinctrl-0 = <&i2c0_pins>;
+		pinctrl-names = "default";
+	};
+};
+
+/*
+ * SPI2 pins. None of the T-Deck Pro's SPI pins sit on the FSPI positions
+ * of the IO MUX (the devkit's 10..13), so all four signals go through the
+ * GPIO matrix, the way the Box-3 device tree does it:
+ *   SCK  GPIO36  signal 101 (FSPICLK)
+ *   MOSI GPIO33  signal 103 (FSPID)
+ *   MISO GPIO47  signal 102 (FSPIQ), input via the matrix
+ *   CS0  GPIO48  signal 110 (FSPICS0), the SD card
+ * Signal numbers: ESP32-S3 TRM table "Peripheral Signals via GPIO Matrix".
+ */
+&gpio_in_mux {
+	status = "ok";
+	spi2_gpio_in: spi2_gpio_in {
+		pinctrl-single,pins = <
+			GPIO_FUNC_IN_SEL(102) 0xaf>;	/* FSPIQ <- GPIO47: SIG_IN_SEL (0x80) | 47 */
+	};
+};
+
+&gpio_out_mux {
+	status = "ok";
+	spi2_gpio_out: spi2_gpio_out {
+		pinctrl-single,pins = <
+			GPIO_FUNC_OUT_SEL(48) 110	/* SPI2 CS0:  GPIO48, signal FSPICS0 */
+			GPIO_FUNC_OUT_SEL(33) 103	/* SPI2 MOSI: GPIO33, signal FSPID */
+			GPIO_FUNC_OUT_SEL(36) 101>;	/* SPI2 SCK:  GPIO36, signal FSPICLK */
+	};
+};
+
+&iomux {
+	status = "ok";
+
+	i2c0_pins: i2c0_pins {
+		pinctrl-single,pins = <
+			PIN(13) FUN0_20MA_IE_WPU		/* SDA */
+			PIN(14) FUN0_20MA_IE_WPU>;		/* SCL */
+	};
+	spi2_pins: spi2_pins {
+		pinctrl-single,pins = <
+			PIN(48) (FUN_SEL(1) | FUN_DRV_20MA)			/* CS0, SD card */
+			PIN(33) (FUN_SEL(1) | FUN_DRV_40MA)			/* MOSI */
+			PIN(36) (FUN_SEL(1) | FUN_DRV_40MA)			/* SCK */
+			PIN(47) (FUN_SEL(1) | FUN_DRV_20MA | FUN_IE | FUN_WPU)	/* MISO */
+			PIN(34) (FUN_SEL(1) | FUN_DRV_20MA)>;			/* e-paper CS, see gpio0 */
+	};
+};
+
+&gpio0 {
+	status = "ok";
+
+	/*
+	 * The e-paper shares SCK and MOSI with the SD card. Hold its chip
+	 * select high so it ignores SD traffic; it has no driver in this
+	 * build. The LoRa module shares the bus too but is unpowered
+	 * (its enable, GPIO46, is left low), so its select is left alone.
+	 */
+	eink_cs_idle {
+		gpio-hog;
+		gpios = <34 GPIO_ACTIVE_HIGH>;
+		output-high;
+		line-name = "eink-cs-idle";
+	};
+};
+
+&spi2 {
+	pinctrl-0 = <&spi2_pins &spi2_gpio_out &spi2_gpio_in>;
+	pinctrl-names = "default";
+	status = "ok";
+
+	mmc_spi@0 {
+		compatible = "mmc-spi-slot";
+		reg = <0>;
+	};
+};
+
+&acm {
+	status = "ok";
+};
+
+&ipc {
+	wifi@1 {
+		compatible = "esp,esp32-wifi-shmem";
+		reg = <1>;
+	};
+};
+
+&intc {
+	reg = <0x600c2800 0x800>;
+};
