--- a/arch/xtensa/boot/dts/esp32s3-tdeck-pro.dts	1970-01-01 00:00:00.000000000 +0000
+++ b/arch/xtensa/boot/dts/esp32s3-tdeck-pro.dts	2026-08-31 10:08:08.720784027 +0000
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * LilyGo T-Deck Pro V1.1 (4G version) -- build three.
+ *
+ * What this describes: the e-paper as the Linux console (with the USB-C
+ * port as a second console), the WiFi link to the core-0 firmware, an I2C
+ * bus on GPIO 13/14 with the TCA8418 keyboard controller on it, and the SD
+ * card slot and the e-paper on SPI2. Nothing else on the board is touched:
+ * touch, LoRa, GPS and the A7682E modem all stay unconfigured and
+ * unpowered.
+ *
+ * Pin numbers come from the pelgraine/Meck T-Deck Pro variant and from
+ * LilyGo's V1.1 schematic (H693 H779 T-DeckPro V1.1 25-09-15).
+ */
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/input/input.h>
+#include "gpio-esp32.h"
+#include "esp32s3.dtsi"
+
+/ {
+	chosen {
+		/*
+		 * Two consoles: the USB-Serial-JTAG port (serial3 in
+		 * esp32s3.dtsi, so ttyGS3) and the e-paper (tty0). The last one
+		 * listed becomes /dev/console, where the login runs; the USB
+		 * port gets its own login from /etc/inittab. vt.color=0x70 is
+		 * black text on a white background, the natural look for
+		 * e-paper; consoleblank=0 stops the console blanking itself,
+		 * which on e-paper would just cost refreshes. UART0 on GPIO
+		 * 43/44 is wired to the GPS on this board and is deliberately
+		 * not a console.
+		 */
+		bootargs = "earlycon=esp32s3acm,mmio32,0x60038000 console=ttyGS3 console=tty0 vt.color=0x70 consoleblank=0 rw root=mtd:rootfs no_hash_pointers ";
+	};
+
+	memory@0 {
+		device_type = "memory";
+		/* 8 MB PSRAM, placed here by the firmware's init_linux_mmap() */
+		reg = <0x3d800000 0x00800000>;
+	};
+
+	i2c0 {
+		#address-cells = <1>;
+		#size-cells = <0>;
+		compatible = "i2c-gpio";
+
+		sda-gpios = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+		scl-gpios = <&gpio0 14 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
+
+		pinctrl-0 = <&i2c0_pins>;
+		pinctrl-names = "default";
+
+		/*
+		 * TCA8418 keyboard controller, INT on GPIO15 (open drain,
+		 * active low; internal pull-up set in keyboard_pins).
+		 *
+		 * Matrix: the schematic wires ROW0..ROW3 and COL0..COL9. The
+		 * driver turns the chip's key number n (1..80) into
+		 * row = (n-1)/10, col = (n-1)%10. Meck's TCA8418Keyboard.h
+		 * and LilyGo's peri_keypad.cpp agree on which key sits at
+		 * which number; the table below is that mapping, one line
+		 * per physical row, right-hand key first (column 0 is the
+		 * right end of each row on this keyboard).
+		 *
+		 * Key names chosen for the five non-letter keys:
+		 *   Alt (row 2, col 9)   -> KEY_LEFTALT
+		 *   $   (row 2, col 1)   -> KEY_YEN
+		 *   Sym (row 3, col 1)   -> KEY_RIGHTALT (the usual "third level" key)
+		 *   Mic (row 3, col 3)   -> KEY_LEFTMETA
+		 *   the two shift keys   -> KEY_RIGHTSHIFT (col 0), KEY_LEFTSHIFT (col 4)
+		 * The console keymap (drivers/tty/vt/defkeymap.c_shipped, patched
+		 * for this board) only covers key codes below 256, so the $ and
+		 * Mic keys use two codes that the default map leaves unused; the
+		 * patched map gives them '$' and Sym+Mic = '0', and makes Sym
+		 * and both Shifts "sticky" one-shot modifiers, as in Meck.
+		 */
+		keyboard@34 {
+			compatible = "ti,tca8418";
+			reg = <0x34>;
+			interrupt-parent = <&gpio0>;
+			interrupts = <15 IRQ_TYPE_LEVEL_LOW>;
+
+			keypad,num-rows = <4>;
+			keypad,num-columns = <10>;
+			keypad,autorepeat;
+			linux,keymap = <
+				/* row 0: P O I U Y T R E W Q */
+				MATRIX_KEY(0, 0, KEY_P)
+				MATRIX_KEY(0, 1, KEY_O)
+				MATRIX_KEY(0, 2, KEY_I)
+				MATRIX_KEY(0, 3, KEY_U)
+				MATRIX_KEY(0, 4, KEY_Y)
+				MATRIX_KEY(0, 5, KEY_T)
+				MATRIX_KEY(0, 6, KEY_R)
+				MATRIX_KEY(0, 7, KEY_E)
+				MATRIX_KEY(0, 8, KEY_W)
+				MATRIX_KEY(0, 9, KEY_Q)
+				/* row 1: Backspace L K J H G F D S A */
+				MATRIX_KEY(1, 0, KEY_BACKSPACE)
+				MATRIX_KEY(1, 1, KEY_L)
+				MATRIX_KEY(1, 2, KEY_K)
+				MATRIX_KEY(1, 3, KEY_J)
+				MATRIX_KEY(1, 4, KEY_H)
+				MATRIX_KEY(1, 5, KEY_G)
+				MATRIX_KEY(1, 6, KEY_F)
+				MATRIX_KEY(1, 7, KEY_D)
+				MATRIX_KEY(1, 8, KEY_S)
+				MATRIX_KEY(1, 9, KEY_A)
+				/* row 2: Enter $ M N B V C X Z Alt */
+				MATRIX_KEY(2, 0, KEY_ENTER)
+				MATRIX_KEY(2, 1, KEY_YEN)
+				MATRIX_KEY(2, 2, KEY_M)
+				MATRIX_KEY(2, 3, KEY_N)
+				MATRIX_KEY(2, 4, KEY_B)
+				MATRIX_KEY(2, 5, KEY_V)
+				MATRIX_KEY(2, 6, KEY_C)
+				MATRIX_KEY(2, 7, KEY_X)
+				MATRIX_KEY(2, 8, KEY_Z)
+				MATRIX_KEY(2, 9, KEY_LEFTALT)
+				/* row 3: RightShift Sym Space Mic LeftShift */
+				MATRIX_KEY(3, 0, KEY_RIGHTSHIFT)
+				MATRIX_KEY(3, 1, KEY_RIGHTALT)
+				MATRIX_KEY(3, 2, KEY_SPACE)
+				MATRIX_KEY(3, 3, KEY_LEFTMETA)
+				MATRIX_KEY(3, 4, KEY_LEFTSHIFT)
+			>;
+
+			pinctrl-0 = <&keyboard_pins>;
+			pinctrl-names = "default";
+		};
+	};
+};
+
+/*
+ * SPI2 pins. None of the T-Deck Pro's SPI pins sit on the FSPI positions
+ * of the IO MUX (the devkit's 10..13), so all signals go through the GPIO
+ * matrix, the way the Box-3 device tree does it:
+ *   SCK  GPIO36  signal 101 (FSPICLK)
+ *   MOSI GPIO33  signal 103 (FSPID)
+ *   MISO GPIO47  signal 102 (FSPIQ), input via the matrix
+ *   CS0  GPIO48  signal 110 (FSPICS0), the SD card
+ *   CS1  GPIO34  signal 111 (FSPICS1), the e-paper
+ * Signal numbers: ESP32-S3 TRM table "Peripheral Signals via GPIO Matrix".
+ */
+&gpio_in_mux {
+	status = "ok";
+	spi2_gpio_in: spi2_gpio_in {
+		pinctrl-single,pins = <
+			GPIO_FUNC_IN_SEL(102) 0xaf>;	/* FSPIQ <- GPIO47: SIG_IN_SEL (0x80) | 47 */
+	};
+};
+
+&gpio_out_mux {
+	status = "ok";
+	spi2_gpio_out: spi2_gpio_out {
+		pinctrl-single,pins = <
+			GPIO_FUNC_OUT_SEL(48) 110	/* SPI2 CS0:  GPIO48, signal FSPICS0 */
+			GPIO_FUNC_OUT_SEL(34) 111	/* SPI2 CS1:  GPIO34, signal FSPICS1 */
+			GPIO_FUNC_OUT_SEL(33) 103	/* SPI2 MOSI: GPIO33, signal FSPID */
+			GPIO_FUNC_OUT_SEL(36) 101>;	/* SPI2 SCK:  GPIO36, signal FSPICLK */
+	};
+};
+
+&iomux {
+	status = "ok";
+
+	i2c0_pins: i2c0_pins {
+		pinctrl-single,pins = <
+			PIN(13) FUN0_20MA_IE_WPU		/* SDA */
+			PIN(14) FUN0_20MA_IE_WPU>;		/* SCL */
+	};
+	keyboard_pins: keyboard_pins {
+		pinctrl-single,pins = <
+			PIN(15) FUN0_20MA_IE_WPU>;		/* TCA8418 INT, open drain */
+	};
+	spi2_pins: spi2_pins {
+		pinctrl-single,pins = <
+			PIN(48) (FUN_SEL(1) | FUN_DRV_20MA)			/* CS0, SD card */
+			PIN(33) (FUN_SEL(1) | FUN_DRV_40MA)			/* MOSI */
+			PIN(36) (FUN_SEL(1) | FUN_DRV_40MA)			/* SCK */
+			PIN(47) (FUN_SEL(1) | FUN_DRV_20MA | FUN_IE | FUN_WPU)	/* MISO */
+			PIN(34) (FUN_SEL(1) | FUN_DRV_20MA)>;			/* CS1, e-paper */
+	};
+	epaper_pins: epaper_pins {
+		pinctrl-single,pins = <
+			PIN(35) (FUN_SEL(1) | FUN_DRV_20MA)			/* DC */
+			PIN(16) (FUN_SEL(1) | FUN_DRV_20MA)			/* RST */
+			PIN(37) (FUN_SEL(1) | FUN_DRV_20MA | FUN_IE)>;		/* BUSY */
+	};
+};
+
+&gpio0 {
+	status = "ok";
+	/*
+	 * The LoRa module shares the SPI bus but is unpowered (its enable,
+	 * GPIO46, is left low), so its chip select is left alone.
+	 */
+};
+
+&spi2 {
+	pinctrl-0 = <&spi2_pins &spi2_gpio_out &spi2_gpio_in>;
+	pinctrl-names = "default";
+	status = "ok";
+
+	mmc_spi@0 {
+		compatible = "mmc-spi-slot";
+		reg = <0>;
+	};
+
+	/*
+	 * GDEQ031T10 e-paper (UC8253 controller), driven by fb_uc8253 with
+	 * Meck's settings: 4 MHz, SPI mode 0, DC on GPIO35, reset on GPIO16
+	 * (active low), busy on GPIO37 (low while busy).
+	 */
+	epaper@1 {
+		compatible = "ultrachip,uc8253";
+		reg = <1>;
+		spi-max-frequency = <4000000>;
+		dc-gpios = <&gpio0 35 GPIO_ACTIVE_HIGH>;
+		reset-gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
+		busy-gpios = <&gpio0 37 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&epaper_pins>;
+		pinctrl-names = "default";
+	};
+};
+
+&acm {
+	status = "ok";
+};
+
+&ipc {
+	wifi@1 {
+		compatible = "esp,esp32-wifi-shmem";
+		reg = <1>;
+	};
+};
+
+&intc {
+	reg = <0x600c2800 0x800>;
+};
