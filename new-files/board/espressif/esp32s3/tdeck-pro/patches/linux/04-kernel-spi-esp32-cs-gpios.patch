diff --git a/drivers/spi/spi-esp32.c b/drivers/spi/spi-esp32.c
index 248048bd2..d7450a9fa 100644
--- a/drivers/spi/spi-esp32.c
+++ b/drivers/spi/spi-esp32.c
@@ -394,6 +394,16 @@ static int esp32_spi_probe(struct platform_device *pdev)
 	host->prepare_message = esp32_spi_prepare_message;
 	host->set_cs = esp32_spi_set_cs;
 	host->transfer_one = esp32_spi_transfer_one;
+	/*
+	 * Allow "cs-gpios" for devices on a shared bus. A hardware chip
+	 * select other than CS0 only drives its pad while its own device
+	 * is being addressed and floats otherwise, which leaves that device
+	 * listening to the bus. With SPI_CONTROLLER_GPIO_SS the core still
+	 * calls set_cs() for GPIO-selected devices, so the hardware selects
+	 * of the other devices are disabled during their transfers.
+	 */
+	host->use_gpio_descriptors = true;
+	host->flags |= SPI_CONTROLLER_GPIO_SS;
 
 	pdev->dev.dma_mask = NULL;
 	/* Configure the SPI host hardware */
